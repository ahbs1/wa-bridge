# ===== Server =====
PORT=3000
JWT_SECRET=ganti_dengan_random_string_32_karakter

# ===== Chatwoot (Global Default) =====
# Ini adalah konfigurasi default/fallback.
# Jika session tidak punya Inbox ID sendiri, akan pakai ini.
CHATWOOT_API_URL=https://chat.example.com
CHATWOOT_API_KEY=your_chatwoot_api_access_token
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_ID=1

# ===== Message Filters =====
IGNORE_BROADCAST=true
IGNORE_STATUS=true
IGNORE_GROUPS=false
IGNORE_CHANNELS=true
